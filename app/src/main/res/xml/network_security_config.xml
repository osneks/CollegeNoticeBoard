<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- By default, disallow cleartext HTTP traffic across the entire internet -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Explicitly scope cleartext HTTP strictly to college legacy domains if needed -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">ajcbosecollege.ac.in</domain>
        <domain includeSubdomains="true">ajcbosecollegeerp.in</domain>
    </domain-config>
</network-security-config>
